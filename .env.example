# Anonymous session starter balance. Charged packs are not sold in this MVP.
STARTER_CREDITS=8

# Pluggable renderer. Only "mock" is implemented.
VIDEO_PROVIDER=mock

# Optional extra check for POST /api/webhooks/provider.
# Callbacks must still present the job's provider id.
PROVIDER_WEBHOOK_SECRET=

# Reserved. Checkout and webhook credit grants stay disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
