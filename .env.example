# Anonymous session starter balance. Charged packs are not sold in this MVP.
STARTER_CREDITS=8

# Pluggable renderer. "mock" (default) and "sub2api" run every render type on that
# adapter. "router" or "sailf" picks a provider from the template's render type
# and suggested model. See docs/render-types.md.
VIDEO_PROVIDER=mock

# Per-type fallback when the suggested model's provider has no key.
# Comma-separated provider names. Defaults are in lib/render-models.ts.
# RENDER_PROVIDER_MOTION_TRANSFER=kling,wan,viggle,sailf
# RENDER_PROVIDER_FACE_SWAP=wan,pixverse,kling,sailf
# RENDER_PROVIDER_IMAGE_TO_VIDEO=sailf,minimax,kling

# Sailf AIGC gateway, used when VIDEO_PROVIDER=sailf.
# Docs: https://aigc-new.sailf.work/#docs — photos are uploaded to /studio-api/assets,
# then POST /v1/videos creates an async task polled via GET /v1/videos/{task_id}.
SAILF_BASE_URL=https://aigc-new.sailf.work
SAILF_API_KEY=
# Public video model id from GET /v1/models or /api/pricing (default: doubao-seedance-2.0-mini).
SAILF_MODEL=model-4e2cf014f835822786c5d25d207257e3-zyf
# Public gateway ids from /api/pricing (doubao-seedance-2-5 and doubao-seedance-2-0).
# SAILF_MODEL_SEEDANCE_25=model-31931a2794d803dce3b998d3e974f349-zyf
# SAILF_MODEL_SEEDANCE_20=model-d46d99cfb921dbdee0b4965fe6e80029-zyf
SAILF_RESOLUTION=720p
SAILF_ASPECT_RATIO=9:16
SAILF_DURATION=5

# Skeletons. A set key opts that provider into the router, but the adapter
# refuses to submit until the live call is wired. Leave them empty.
KLING_API_KEY=
FAL_KEY=
DASHSCOPE_API_KEY=
MINIMAX_API_KEY=
VEO_API_KEY=
VIGGLE_API_KEY=
VIDU_API_KEY=
RUNWAY_API_KEY=

# Sub2API upstream gateway, used when VIDEO_PROVIDER=sub2api.
# Renders call POST {SUB2API_BASE_URL}/chat/completions with multimodal input.
SUB2API_BASE_URL=https://ai-net.clariontech.top/v1
SUB2API_API_KEY=
SUB2API_MODEL=gemini-2.5-flash

# Optional extra check for POST /api/webhooks/provider.
# Callbacks must still present the job's provider id.
PROVIDER_WEBHOOK_SECRET=

# Reserved. Checkout and webhook credit grants stay disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
